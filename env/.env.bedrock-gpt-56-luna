# this is a sample for keys used in this code repo.
# Please rename it to .env before you can use it

# basic info
MODEL_PROVIDER=bedrock_openai  # azureopenai, bedrock, bedrock_openai, openai, azureml, azureaifoundry, huggingface
MODEL_NAME=gpt-5.6-luna
MODEL_VERSION=2026-07-13
IS_DEBUG=false

# Reasoning Configuration (applies to all providers)
REASONING_ENABLED=true
REASONING_EFFORT=medium # none, minimal, low, medium, high

# AWS Bedrock - OpenAI models (bedrock-mantle endpoint, Responses API only)
BEDROCK_OPENAI_MODEL_ID=openai.gpt-5.6-luna
AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK is read from the shell environment, not stored here

# Wait time between requests (seconds) - helps avoid throttling
WAIT_TIME=30
