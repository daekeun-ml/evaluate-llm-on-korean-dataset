# this is a sample for keys used in this code repo.
# Please rename it to .env before you can use it

# basic info
MODEL_PROVIDER=openai  # azureopenai, bedrock, bedrock_openai, openai, azureml, azureaifoundry, huggingface
MODEL_NAME=deepseek-v4-flash-thinking-max
MODEL_VERSION=0731
IS_DEBUG=false

# Reasoning Configuration (applies to all providers)
# DeepSeek-V4-Flash-0731 only supports low/high/max reasoning_effort (no "medium").
REASONING_ENABLED=true
REASONING_EFFORT=max # low, high, max (DeepSeek-V4-Flash levels)

# reasoning_effort=max is a prompt telling the model not to stop until it has verified the
# answer from multiple angles, so on hard items it never emits </think> and the response
# comes back empty (KoBALT-700: 44% empty even at max_tokens=8192). With FORCED_THINK_CLOSE
# we call raw /completions and force the thinking block closed once the budget runs out.
# Measured on the first 30 KoBALT items: 80.0% acc / 0 empty, vs 73.3% for a
# prompt-constrained "think briefly" variant. See util/forced_close_llm.py.
FORCED_THINK_CLOSE=true

# OpenAI-compatible endpoint (self-hosted vLLM server, see deepseek-v4-flash-serving-guide)
OPENAI_DEPLOYMENT_NAME=deepseek-v4-flash
OPENAI_API_BASE=http://localhost:8000/v1
OPENAI_API_KEY=EMPTY

# Wait time between requests (seconds) - helps avoid throttling
WAIT_TIME=1
